# Copie para .env e ajuste. NUNCA commitar o .env de verdade — ver .gitignore
# na raiz do repositório.

# --- Desenvolvimento local (padrão) --------------------------------------
# SQLite: um arquivo único, criado automaticamente na primeira execução.
# Não precisa instalar nada nem criar conta em lugar nenhum.
DATABASE_URL=sqlite:///./vila_bela.db

# Senha única da área administrativa/operacional no ambiente local (ver
# backend/app/routers/auth.py). Troque por algo só seu, não deixe o valor
# de exemplo em uso real.
ADMIN_SENHA=0123456

# --- Publicação (quando o projeto for ao ar de verdade) -------------------
# Descomente e preencha estas quatro linhas só nesse momento; até lá, deixe
# como estão. Ver CLAUDE.md > Stack para a diferença entre os dois ambientes.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
